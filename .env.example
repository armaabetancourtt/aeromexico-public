# Public reservation tier
PUBLIC_PORT=8080
NODE_ENV=production

# MongoDB should be reachable from this host/network.
# In AWS, use the internal/private endpoint rather than a public database.
MONGO_URI=mongodb://<private-db-host>:27017/vuelos

# Optional. Leave unset when the frontend and API share the same origin through Nginx.
# CORS_ORIGIN=https://example.com
